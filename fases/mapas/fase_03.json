 "dialogos": [
  {
   "coluna": 4,
   "texto": "O Castelo do Inverno Eterno...\nO último fragmento deve estar lá dentro!",
   "duracao": 4.4
  },
  {
   "coluna": 42,
   "texto": "Pontes de gelo... melhor não olhar para baixo.",
   "duracao": 3.2
  },
  {
   "coluna": 102,
   "texto": "A montanha é íngreme... e o vento só piora.",
   "duracao": 3.2
  },
  {
   "coluna": 143,
   "texto": "O cume! Um passo em falso e... bem, melhor não errar.",
   "duracao": 3.6
  },
  {
   "coluna": 196,
   "texto": "O castelo está tão perto... posso sentir o gelo dele.",
   "duracao": 3.6
  },
  {
   "coluna": 247,
   "texto": "O fosso... e as muralhas. É agora!",
   "duracao": 3.2
  },
  {
   "coluna": 300,
   "texto": "O terceiro fragmento!\nCom ele, a chave estará completa.",
   "duracao": 4.0
  }
 ],
